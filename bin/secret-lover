#!/bin/bash
#
# secret-lover - The one who keeps your secrets
# Credential broker for macOS Keychain with Touch ID
# Supports project namespacing for per-project secrets
#

set -e

SERVICE_BASE="secret-lover"
LOG_DIR="$HOME/.secret-lover"
LOG_FILE="$LOG_DIR/access.log"

# Find the keychain helper (Touch ID support)
SCRIPT_DIR="$(cd "$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")" && pwd)"
HELPER="$SCRIPT_DIR/keychain-helper"

# Auth session cache (avoids multiple prompts within window)
AUTH_CACHE_FILE="$LOG_DIR/.auth_session"
AUTH_CACHE_SECONDS=60

# Prompt policy: SECRET_LOVER_PROMPT=never|auto|always (default auto)
#   auto   - prompt only when a value is about to be DISPLAYED on a terminal
#            (`get` with a tty). `run` injects silently, so agents and
#            background jobs never block on a prompt.
#   always - prompt (with the 60 s cache) for every retrieval
#   never  - never prompt
PROMPT_POLICY="${SECRET_LOVER_PROMPT:-auto}"
LOG_MAX_BYTES=5000000

# Ensure log directory exists
mkdir -p "$LOG_DIR"

# Global variables set by detect_project
PROJECT=""
SERVICE="$SERVICE_BASE"

# Check if auth session is still valid
is_auth_cached() {
    if [[ -f "$AUTH_CACHE_FILE" ]]; then
        local cached_time
        cached_time=$(cat "$AUTH_CACHE_FILE" 2>/dev/null)
        local now
        now=$(date +%s)
        if [[ -n "$cached_time" ]] && (( now - cached_time < AUTH_CACHE_SECONDS )); then
            return 0
        fi
    fi
    return 1
}

# Update auth cache after successful authentication
update_auth_cache() {
    date +%s > "$AUTH_CACHE_FILE"
    chmod 600 "$AUTH_CACHE_FILE"
}

log_access() {
    local action="$1"
    local name="$2"
    local status="$3"
    local tty_name
    tty_name=$(tty 2>/dev/null) || tty_name="none"
    local project_info=""
    [[ -n "$PROJECT" ]] && project_info=" | project=$PROJECT"
    # Rotate when the log gets big (keeps one previous generation)
    if [[ -f "$LOG_FILE" ]]; then
        local size
        size=$(stat -f %z "$LOG_FILE" 2>/dev/null || echo 0)
        if (( size > LOG_MAX_BYTES )); then
            mv "$LOG_FILE" "$LOG_FILE.1"
        fi
    fi
    echo "$(date -Iseconds) | $action | $name | $status | pid=$$${project_info}" >> "$LOG_FILE"
}

# Should this retrieval prompt for Touch ID?  $1 = "display" or "inject"
should_prompt() {
    case "$PROMPT_POLICY" in
        never)  return 1 ;;
        always) return 0 ;;
        *)      [[ "$1" == "display" && -t 1 ]] ;;
    esac
}

# Where else does a secret with this name live?  (for "not found" hints)
where_is() {
    local name="$1"
    [[ -x "$HELPER" ]] || return 0
    "$HELPER" list-all 2>/dev/null | awk -F'\t' -v n="$name" '$1==n {print $2}' | tr '\n' ' '
}

# Detect project from .secrets.json or directory name
detect_project() {
    local secrets_file
    secrets_file=$(find_secrets_file 2>/dev/null) || true

    # Explicit override wins: --project flag (sets PROJECT_OVERRIDE) or env
    if [[ -n "${PROJECT_OVERRIDE:-${SECRET_LOVER_PROJECT:-}}" ]]; then
        PROJECT="${PROJECT_OVERRIDE:-$SECRET_LOVER_PROJECT}"
        [[ "$PROJECT" == "global" ]] && PROJECT=""
    elif [[ -n "$secrets_file" ]]; then
        # Try to get project from .secrets.json
        local json_project
        json_project=$(grep -o '"project"[[:space:]]*:[[:space:]]*"[^"]*"' "$secrets_file" 2>/dev/null | sed 's/.*: *"\([^"]*\)"/\1/' || true)

        if [[ -n "$json_project" ]]; then
            PROJECT="$json_project"
        else
            # Use directory name containing .secrets.json
            PROJECT=$(basename "$(dirname "$secrets_file")")
        fi
    fi

    # Set service name based on project
    if [[ -n "$PROJECT" ]]; then
        SERVICE="$SERVICE_BASE/$PROJECT"
    fi
}

find_secrets_file() {
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -f "$dir/.secrets.json" ]]; then
            echo "$dir/.secrets.json"
            return 0
        fi
        dir=$(dirname "$dir")
    done
    return 1
}

# Check if secret exists (no auth, for verification)
secret_exists() {
    local name="$1"

    if [[ -x "$HELPER" ]]; then
        # Use non-auth get to check existence
        if [[ -n "$PROJECT" ]]; then
            "$HELPER" get "$name" "$PROJECT" >/dev/null 2>&1 && return 0
        fi
        "$HELPER" get "$name" >/dev/null 2>&1 && return 0
        return 1
    fi

    # Fallback to security CLI
    if [[ -n "$PROJECT" ]]; then
        security find-generic-password -a "$name" -s "$SERVICE_BASE/$PROJECT" -w >/dev/null 2>&1 && return 0
    fi
    security find-generic-password -a "$name" -s "$SERVICE_BASE" -w >/dev/null 2>&1 && return 0
    return 1
}

# Get secret with fallback: project-specific -> global
# Uses Touch ID if helper is available (with session caching)
get_secret() {
    local name="$1"
    local context="${2:-inject}"  # "display" (value printed) or "inject" (env only)
    local value

    # Use helper if available (Touch ID support)
    if [[ -x "$HELPER" ]]; then
        local cmd="get"

        # Prompt only when policy says so, and not within the cache window
        if should_prompt "$context" && ! is_auth_cached; then
            cmd="get-auth"
        fi

        if [[ -n "$PROJECT" ]]; then
            if value=$("$HELPER" "$cmd" "$name" "$PROJECT" 2>/dev/null); then
                [[ "$cmd" == "get-auth" ]] && update_auth_cache
                echo "$value"
                return 0
            fi
        fi
        # Fallback to global
        if value=$("$HELPER" "$cmd" "$name" 2>/dev/null); then
            [[ "$cmd" == "get-auth" ]] && update_auth_cache
            echo "$value"
            return 0
        fi
        return 1
    fi

    # Fallback to security CLI (no Touch ID)
    if [[ -n "$PROJECT" ]]; then
        if value=$(security find-generic-password -a "$name" -s "$SERVICE_BASE/$PROJECT" -w 2>/dev/null); then
            echo "$value"
            return 0
        fi
    fi

    if value=$(security find-generic-password -a "$name" -s "$SERVICE_BASE" -w 2>/dev/null); then
        echo "$value"
        return 0
    fi

    return 1
}

show_help() {
    cat << 'EOF'
secret-lover - The one who keeps your secrets

COMMANDS:
  secret-lover add NAME [VALUE]        Add a secret (prompts if VALUE omitted)
  secret-lover add NAME --global       Add as global (not project-specific)
  secret-lover get NAME                Retrieve a secret (requires Touch ID)
  secret-lover list                    List all stored secret names
  secret-lover list --all              List secrets for all projects
  secret-lover delete NAME             Remove a secret
  secret-lover check                   Check if Touch ID is available
  secret-lover clear-auth              Clear auth session (force re-auth)
  secret-lover migrate                 Re-save existing secrets with Touch ID
  secret-lover help                    Show this help

PROJECT COMMANDS:
  secret-lover run -- <command>        Run command with .secrets.json injected
  secret-lover run --project P --secret K -- <cmd>   No manifest needed
  secret-lover run --project P --all -- <cmd>        Inject every P + global secret
  secret-lover init [PROJECT]          Create .secrets.json template
  secret-lover verify                  Check all project secrets exist
  secret-lover import FILE.env [-p P]  Pull a dotenv file into the Keychain

HYGIENE:
  secret-lover scrub [PATHS...]        Find secret VALUES in Claude transcripts,
                                       shell history and logs (default paths)
  secret-lover scrub --fix             Replace them in place with <REDACTED:NAME>

PROJECT NAMESPACING:
  Secrets are stored per-project by default. Project is auto-detected from:
  1. "project" field in .secrets.json
  2. Directory name containing .secrets.json

  When retrieving, falls back to global secrets if no project-specific found.

EXAMPLES:
  # In ~/myproject with .secrets.json
  secret-lover add SUPABASE_URL        # Stored for "myproject"
  secret-lover add OPENAI_KEY --global # Stored globally (shared)

  # Different projects can have different SUPABASE_URLs
  cd ~/projectA && secret-lover add SUPABASE_URL "https://a.supabase.co"
  cd ~/projectB && secret-lover add SUPABASE_URL "https://b.supabase.co"

PROMPTS (SECRET_LOVER_PROMPT=auto|always|never, default auto):
  - auto:   Touch ID only when `get` is about to print a value on a terminal.
            `run` injects silently, so agents and background jobs never block.
  - always: prompt on every retrieval (cached 60 s; 'clear-auth' resets)
  - never:  no prompts at all

WHAT THIS IS (honestly):
  - Per-project namespacing of secrets in the macOS login Keychain
  - Injection into ONE command, so values stay out of transcripts and shell history
  - An audit log at ~/.secret-lover/access.log (names only, never values)
  - `scrub` to find and redact values that leaked anyway
  - It is NOT an access boundary: any process running as you can read the
    login Keychain. Touch ID here is a confirmation step, not a lock.

EOF
}

cmd_add() {
    local name=""
    local value=""
    local global=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --global|-g)
                global=true
                shift
                ;;
            *)
                if [[ -z "$name" ]]; then
                    name="$1"
                elif [[ -z "$value" ]]; then
                    value="$1"
                fi
                shift
                ;;
        esac
    done

    if [[ -z "$name" ]]; then
        echo "Usage: secret-lover add NAME [VALUE] [--global]" >&2
        exit 1
    fi

    # Detect project unless --global
    if ! $global; then
        detect_project
    fi

    # If no value provided, prompt securely
    if [[ -z "$value" ]]; then
        local prompt="Enter value for $name"
        [[ -n "$PROJECT" ]] && prompt="$prompt (project: $PROJECT)"
        echo -n "$prompt: "
        read -s value
        echo

        if [[ -z "$value" ]]; then
            echo "Error: Empty value not allowed" >&2
            exit 1
        fi
    fi

    # Add to keychain using helper (Touch ID) or security CLI
    local success=false
    if [[ -x "$HELPER" ]]; then
        if [[ -n "$PROJECT" ]] && ! $global; then
            "$HELPER" add "$name" "$value" "$PROJECT" >/dev/null 2>&1 && success=true
        else
            "$HELPER" add "$name" "$value" >/dev/null 2>&1 && success=true
        fi
    else
        # Fallback to security CLI
        security delete-generic-password -a "$name" -s "$SERVICE" 2>/dev/null || true
        security add-generic-password -a "$name" -s "$SERVICE" -w "$value" -T "" 2>/dev/null && success=true
    fi

    if $success; then
        log_access "ADD" "$name" "success"
        if [[ -n "$PROJECT" ]] && ! $global; then
            echo "✓ Stored: $name (project: $PROJECT)"
        else
            echo "✓ Stored: $name (global)"
        fi
    else
        log_access "ADD" "$name" "failed"
        echo "✗ Failed to store: $name" >&2
        exit 1
    fi
}

cmd_get() {
    local name="$1"

    if [[ -z "$name" ]]; then
        echo "Usage: secret-lover get NAME" >&2
        exit 1
    fi

    detect_project

    local value
    if value=$(get_secret "$name" display); then
        log_access "GET" "$name" "success"
        echo "$value"
    else
        log_access "GET" "$name" "not_found"
        echo "Error: Secret '$name' not found" >&2
        [[ -n "$PROJECT" ]] && echo "  (checked project '$PROJECT' and global)" >&2
        local elsewhere
        elsewhere=$(where_is "$name")
        [[ -n "$elsewhere" ]] && echo "  It exists in namespace(s): $elsewhere — use --project NAME or SECRET_LOVER_PROJECT=NAME" >&2
        exit 1
    fi
}

cmd_list() {
    local show_all=false
    [[ "$1" == "--all" || "$1" == "-a" ]] && show_all=true

    detect_project

    if [[ -x "$HELPER" ]]; then
        # Use helper for listing
        if $show_all; then
            echo "All secrets in Keychain:"
            echo
            "$HELPER" list-all | while IFS=$'\t' read -r name proj; do
                if [[ "$proj" == "global" ]]; then
                    echo "  $name (global)"
                else
                    echo "  $name ($proj)"
                fi
            done | sort
        else
            if [[ -n "$PROJECT" ]]; then
                echo "Secrets for project '$PROJECT':"
            else
                echo "Global secrets:"
            fi
            echo

            if [[ -n "$PROJECT" ]]; then
                "$HELPER" list "$PROJECT" | while read -r name; do
                    echo "  $name"
                done
            else
                "$HELPER" list | while read -r name; do
                    echo "  $name"
                done
            fi

            if [[ -n "$PROJECT" ]]; then
                echo
                echo "Also inherits global secrets (use --all to see)"
            fi
        fi
    else
        # Fallback to security CLI
        if $show_all; then
            echo "All secrets in Keychain:"
            echo
            security dump-keychain 2>/dev/null | awk '
                /0x00000007.*="secret-lover/ {
                    match($0, /"secret-lover[^"]*"/)
                    svc = substr($0, RSTART+1, RLENGTH-2)
                    found=1
                }
                found && /"acct"/ {
                    match($0, /<blob>="[^"]*"/)
                    name = substr($0, RSTART+8, RLENGTH-9)
                    if (svc == "secret-lover") {
                        print "  " name " (global)"
                    } else {
                        proj = substr(svc, 14)
                        print "  " name " (" proj ")"
                    }
                    found=0
                }
            ' | sort
        else
            if [[ -n "$PROJECT" ]]; then
                echo "Secrets for project '$PROJECT':"
            else
                echo "Global secrets:"
            fi
            echo

            local escaped_service="${SERVICE//\//\\/}"
            security dump-keychain 2>/dev/null | awk -v svc="$SERVICE" '
                /0x00000007.*="'"$escaped_service"'"/ { found=1 }
                found && /"acct"/ {
                    gsub(/.*<blob>="/, "  ")
                    gsub(/"$/, "")
                    print
                    found=0
                }
            ' | sort -u

            if [[ -n "$PROJECT" ]]; then
                echo
                echo "Also inherits global secrets (use --all to see)"
            fi
        fi
    fi

    log_access "LIST" "-" "success"
}

cmd_delete() {
    local name="$1"

    if [[ -z "$name" ]]; then
        echo "Usage: secret-lover delete NAME" >&2
        exit 1
    fi

    detect_project

    local deleted=false

    if [[ -x "$HELPER" ]]; then
        # Try project-specific first
        if [[ -n "$PROJECT" ]] && "$HELPER" delete "$name" "$PROJECT" >/dev/null 2>&1; then
            log_access "DELETE" "$name" "success"
            echo "✓ Deleted: $name (project: $PROJECT)"
            deleted=true
        elif "$HELPER" delete "$name" >/dev/null 2>&1; then
            log_access "DELETE" "$name" "success (global)"
            echo "✓ Deleted: $name (global)"
            deleted=true
        fi
    else
        # Fallback to security CLI
        if security delete-generic-password -a "$name" -s "$SERVICE" >/dev/null 2>&1; then
            log_access "DELETE" "$name" "success"
            if [[ -n "$PROJECT" ]]; then
                echo "✓ Deleted: $name (project: $PROJECT)"
            else
                echo "✓ Deleted: $name (global)"
            fi
            deleted=true
        elif [[ -n "$PROJECT" ]] && security delete-generic-password -a "$name" -s "$SERVICE_BASE" >/dev/null 2>&1; then
            log_access "DELETE" "$name" "success (global)"
            echo "✓ Deleted: $name (global)"
            deleted=true
        fi
    fi

    if ! $deleted; then
        log_access "DELETE" "$name" "not_found"
        echo "✗ Secret '$name' not found" >&2
        exit 1
    fi
}

cmd_clear_auth() {
    if [[ -f "$AUTH_CACHE_FILE" ]]; then
        rm -f "$AUTH_CACHE_FILE"
        echo "✓ Auth session cleared"
    else
        echo "No active auth session"
    fi
}

cmd_check() {
    echo "Checking Touch ID availability..."

    if bioutil -r 2>/dev/null | grep -q "Touch ID"; then
        echo "✓ Touch ID is available"
    elif bioutil -r 2>/dev/null | grep -q "biometry"; then
        echo "✓ Biometric authentication available"
    else
        echo "⚠ Touch ID not detected (password auth will be used)"
    fi

    echo
    echo "Testing Keychain access..."
    local test_name="_secret_lover_test_$$"

    if security add-generic-password -a "$test_name" -s "$SERVICE_BASE" -w "test" -T "" 2>/dev/null; then
        security delete-generic-password -a "$test_name" -s "$SERVICE_BASE" 2>/dev/null
        echo "✓ Keychain read/write working"
    else
        echo "✗ Keychain access failed" >&2
        exit 1
    fi

    echo
    echo "All checks passed!"
}

cmd_init() {
    local project_name="${1:-$(basename "$PWD")}"
    local secrets_file=".secrets.json"

    if [[ -f "$secrets_file" ]]; then
        echo "⚠ $secrets_file already exists" >&2
        exit 1
    fi

    cat > "$secrets_file" << EOF
{
  "project": "$project_name",
  "secrets": [
    "EXAMPLE_API_KEY"
  ],
  "env": {}
}
EOF

    echo "✓ Created $secrets_file for project '$project_name'"
    echo "  Edit to add your secret names to the \"secrets\" array, then run:"
    echo "  secret-lover add EXAMPLE_API_KEY"
}

cmd_verify() {
    local secrets_file
    secrets_file=$(find_secrets_file)

    if [[ -z "$secrets_file" ]]; then
        echo "Error: No .secrets.json found in current directory or parents" >&2
        exit 1
    fi

    detect_project

    echo "Checking secrets from: $secrets_file"
    [[ -n "$PROJECT" ]] && echo "Project: $PROJECT"
    echo

    local missing=0
    local found=0

    # Parse keychain secret names from "secrets" array
    local keychain_names
    keychain_names=$(python3 -c "
import json, sys
with open('$secrets_file') as f:
    data = json.load(f)
for name in data.get('secrets', []):
    print(name)
" 2>/dev/null)

    # Parse static env var names from "env" object
    local env_names
    env_names=$(python3 -c "
import json, sys
with open('$secrets_file') as f:
    data = json.load(f)
for name in data.get('env', {}).keys():
    print(name)
" 2>/dev/null)

    # Check keychain secrets
    for name in $keychain_names; do
        if secret_exists "$name"; then
            if [[ -n "$PROJECT" ]]; then
                if [[ -x "$HELPER" ]] && "$HELPER" get "$name" "$PROJECT" >/dev/null 2>&1; then
                    echo "  ✓ $name (keychain/project)"
                elif security find-generic-password -a "$name" -s "$SERVICE" -w >/dev/null 2>&1; then
                    echo "  ✓ $name (keychain/project)"
                else
                    echo "  ✓ $name (keychain/global)"
                fi
            else
                echo "  ✓ $name (keychain)"
            fi
            ((found++))
        else
            echo "  ✗ $name (missing from keychain)"
            ((missing++))
        fi
    done

    # Check static env vars (always present if in file)
    for name in $env_names; do
        echo "  ✓ $name (env)"
        ((found++))
    done

    echo
    if [[ $missing -eq 0 ]]; then
        echo "All $found secrets found!"
    else
        echo "$missing secret(s) missing. Add them with:"
        echo "  secret-lover add NAME"
        exit 1
    fi
}

cmd_run() {
    # Parse options
    local timeout_secs=""
    local explicit_names=()
    local inject_all=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --timeout)
                timeout_secs="$2"
                shift 2
                ;;
            --project|-p)
                PROJECT_OVERRIDE="$2"
                shift 2
                ;;
            --secret|-s)
                explicit_names+=("$2")
                shift 2
                ;;
            --all)
                inject_all=true
                shift
                ;;
            --)
                shift
                break
                ;;
            *)
                break
                ;;
        esac
    done

    if [[ $# -eq 0 ]]; then
        echo "Usage: secret-lover run [--project P] [--secret NAME]... [--all] [--timeout SECS] -- <command>" >&2
        exit 1
    fi

    local secrets_file
    secrets_file=$(find_secrets_file 2>/dev/null) || true

    if [[ -z "$secrets_file" && ${#explicit_names[@]} -eq 0 && "$inject_all" == false ]]; then
        echo "Error: No .secrets.json found in current directory or parents" >&2
        echo "Either run 'secret-lover init', or name the secrets on the command line:" >&2
        echo "  secret-lover run --project NAME --secret KEY -- <command>" >&2
        echo "  secret-lover run --project NAME --all -- <command>" >&2
        exit 1
    fi

    detect_project

    # Build environment
    local env_vars=()
    local missing=()
    local names=()

    # 1. Which keychain names to inject: manifest "secrets" array, --secret flags, and/or --all
    if [[ -n "$secrets_file" ]]; then
        while IFS= read -r n; do
            [[ -n "$n" ]] && names+=("$n")
        done < <(python3 -c "
import json, sys
with open('$secrets_file') as f:
    data = json.load(f)
for name in data.get('secrets', []):
    print(name)
" 2>/dev/null)
    fi
    for n in "${explicit_names[@]+"${explicit_names[@]}"}"; do names+=("$n"); done
    if $inject_all && [[ -x "$HELPER" ]]; then
        # every name in the project namespace plus every global name
        while IFS=$'\t' read -r n ns; do
            if [[ "$ns" == "global" || ( -n "$PROJECT" && "$ns" == "$PROJECT" ) ]]; then
                names+=("$n")
            fi
        done < <("$HELPER" list-all 2>/dev/null)
    fi

    local seen=" "
    for name in "${names[@]+"${names[@]}"}"; do
        [[ "$seen" == *" $name "* ]] && continue
        seen+="$name "
        local value
        if value=$(get_secret "$name" inject); then
            env_vars+=("$name=$value")
            log_access "INJECT" "$name" "success"
        else
            missing+=("$name")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        echo "Warning: ${#missing[@]} secret(s) not found for project '${PROJECT:-global}' (skipping):" >&2
        for m in "${missing[@]}"; do
            local elsewhere
            elsewhere=$(where_is "$m")
            if [[ -n "$elsewhere" ]]; then
                echo "  $m  (exists in: $elsewhere)" >&2
            else
                echo "  $m" >&2
            fi
        done
    fi

    # 2. Inject static env vars from "env" object
    if [[ -n "$secrets_file" ]]; then
        local env_pairs
        env_pairs=$(python3 -c "
import json, sys
with open('$secrets_file') as f:
    data = json.load(f)
for k, v in data.get('env', {}).items():
    print(f'{k}={v}')
" 2>/dev/null)

        while IFS= read -r pair; do
            [[ -n "$pair" ]] && env_vars+=("$pair")
        done <<< "$env_pairs"
    fi

    # Execute command with secrets injected
    # Uses process group management to ensure child processes are killed on exit
    log_access "RUN" "$(basename "$1")" "executing"

    # Track PID for external discovery
    local pid_dir="/tmp/secret-lover-pids"
    mkdir -p "$pid_dir" 2>/dev/null

    # Export env vars and run with process cleanup
    for var in "${env_vars[@]}"; do
        export "$var"
    done

    "$@" &
    local child_pid=$!
    echo "$child_pid" > "$pid_dir/$$.pid"

    # Ensure child process tree dies when we do (|| true needed because set -e)
    trap "rm -f '$pid_dir/$$.pid' || true; kill $child_pid 2>/dev/null || true; pkill -P $child_pid 2>/dev/null || true" EXIT TERM INT HUP

    # If timeout set, spawn a watchdog that kills the child after N seconds
    if [[ -n "$timeout_secs" ]]; then
        (
            sleep "$timeout_secs"
            echo "secret-lover: timeout after ${timeout_secs}s — killing process" >&2
            kill $child_pid 2>/dev/null
            pkill -P $child_pid 2>/dev/null
        ) &
        local watchdog_pid=$!
        trap "rm -f '$pid_dir/$$.pid' || true; kill $child_pid 2>/dev/null || true; pkill -P $child_pid 2>/dev/null || true; kill $watchdog_pid 2>/dev/null || true" EXIT TERM INT HUP
    fi

    wait $child_pid
}

cmd_migrate() {
    echo "Migrating secrets to Touch ID..."
    echo

    if [[ ! -x "$HELPER" ]]; then
        echo "Error: keychain-helper not found at $HELPER" >&2
        echo "Touch ID migration requires the helper binary." >&2
        exit 1
    fi

    local count=0
    local failed=0

    # Get all secrets using security CLI (old format)
    while IFS=$'\t' read -r name svc; do
        [[ -z "$name" ]] && continue

        # Read value using security CLI
        local value
        if value=$(security find-generic-password -a "$name" -s "$svc" -w 2>/dev/null); then
            # Determine project
            local project=""
            if [[ "$svc" != "secret-lover" ]]; then
                project="${svc#secret-lover/}"
            fi

            # Delete old item using security CLI (same tool that created it)
            security delete-generic-password -a "$name" -s "$svc" >/dev/null 2>&1 || true

            # Re-save with helper (Touch ID enabled)
            local label="global"
            [[ -n "$project" ]] && label="$project"

            if [[ -n "$project" ]]; then
                if "$HELPER" add "$name" "$value" "$project" >/dev/null 2>&1; then
                    echo "  ✓ $name ($label)"
                    ((count++))
                else
                    echo "  ✗ $name ($label) - failed to add"
                    ((failed++))
                fi
            else
                if "$HELPER" add "$name" "$value" >/dev/null 2>&1; then
                    echo "  ✓ $name ($label)"
                    ((count++))
                else
                    echo "  ✗ $name ($label) - failed to add"
                    ((failed++))
                fi
            fi
        else
            # Determine project for error message
            local label="global"
            [[ "$svc" != "secret-lover" ]] && label="${svc#secret-lover/}"
            echo "  ✗ $name ($label) - failed to read"
            ((failed++))
        fi
    done < <(security dump-keychain 2>/dev/null | awk '
        /0x00000007.*="secret-lover/ {
            match($0, /"secret-lover[^"]*"/)
            svc = substr($0, RSTART+1, RLENGTH-2)
            found=1
        }
        found && /"acct"/ {
            match($0, /<blob>="[^"]*"/)
            name = substr($0, RSTART+8, RLENGTH-9)
            print name "\t" svc
            found=0
        }
    ')

    echo
    if [[ $failed -eq 0 ]]; then
        echo "Migrated $count secrets to Touch ID!"
    else
        echo "Migrated $count secrets, $failed failed."
        exit 1
    fi
}


# Import a dotenv file into the Keychain (values are never printed)
cmd_import() {
    local file="" ; local as_global=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --project|-p) PROJECT_OVERRIDE="$2"; shift 2 ;;
            --global|-g)  as_global=true; shift ;;
            *) file="$1"; shift ;;
        esac
    done
    if [[ -z "$file" || ! -f "$file" ]]; then
        echo "Usage: secret-lover import FILE.env [--project NAME | --global]" >&2
        exit 1
    fi
    detect_project
    $as_global && PROJECT=""
    if [[ ! -x "$HELPER" ]]; then
        echo "Error: keychain-helper not found" >&2; exit 1
    fi
    local count=0 skipped=0
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line#export }"
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
        [[ "$line" != *=* ]] && continue
        local key="${line%%=*}" val="${line#*=}"
        key="$(echo "$key" | tr -d '[:space:]')"
        [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { ((skipped++)); continue; }
        # strip surrounding quotes
        if [[ "$val" =~ ^\"(.*)\"$ ]]; then val="${BASH_REMATCH[1]}"; elif [[ "$val" =~ ^\'(.*)\'$ ]]; then val="${BASH_REMATCH[1]}"; fi
        if [[ -z "$val" ]]; then ((skipped++)); continue; fi
        if "$HELPER" add "$key" "$val" ${PROJECT:+"$PROJECT"} >/dev/null 2>&1; then
            ((count++)); log_access "ADD" "$key" "import"
        else
            echo "  failed: $key" >&2; ((skipped++))
        fi
    done < "$file"
    echo "Imported $count secret(s) into '${PROJECT:-global}' from $(basename "$file") ($skipped skipped)."
    echo "Verify with: secret-lover list${PROJECT:+ --project $PROJECT}"
}

# Find (and optionally redact) secret VALUES in transcripts, shell history and logs.
# Values come straight from the Keychain (no prompt); nothing is ever printed.
cmd_scrub() {
    local SCRUB_PY
    read -r -d '' SCRUB_PY <<'PY' || true
import os, re, sys, stat
fix = os.environ["SL_FIX"] == "true"
min_len = int(os.environ["SL_MIN"]); skip_re = re.compile(os.environ["SL_SKIP"])
secrets = {}   # value(bytes) -> label
skipped = []
for line in sys.stdin.buffer.read().splitlines():
    try: name, ns, val = line.split(b"\t", 2)
    except ValueError: continue
    label = name.decode() + ("" if ns == b"global" else "@" + ns.decode())
    if len(val) < min_len or skip_re.search(name.decode()):
        skipped.append(label); continue
    secrets.setdefault(val, label)
if not secrets:
    print("No scrubbable secrets (all too short or skipped)."); sys.exit(0)
# longest first so a value that contains another is redacted whole
pattern = re.compile(b"|".join(re.escape(v) for v in sorted(secrets, key=len, reverse=True)))
MAX = 200 * 1024 * 1024
hits = {}      # label -> [files]
files_touched = 0; files_scanned = 0
SKIP_DIRS = {"node_modules", ".git", "__pycache__", ".venv"}
def walk(p):
    if os.path.isfile(p): yield p; return
    for root, dirs, files in os.walk(p):
        dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
        for f in files: yield os.path.join(root, f)
for base in sys.argv[1:]:
    if not os.path.exists(base): continue
    for path in walk(base):
        try:
            st = os.lstat(path)
            if not stat.S_ISREG(st.st_mode) or st.st_size > MAX or st.st_size == 0: continue
            with open(path, "rb") as fh: data = fh.read()
        except OSError: continue
        files_scanned += 1
        found = set()
        def sub(m):
            label = secrets[m.group(0)]; found.add(label)
            return b"<REDACTED:" + label.encode() + b">"
        new = pattern.sub(sub, data)
        if not found: continue
        for label in found: hits.setdefault(label, []).append(path)
        if fix:
            tmp = path + ".sl-scrub-tmp"
            with open(tmp, "wb") as fh: fh.write(new)
            os.chmod(tmp, stat.S_IMODE(st.st_mode)); os.replace(tmp, path)
            files_touched += 1
print(f"Scanned {files_scanned} files under: " + ", ".join(sys.argv[1:]))
if skipped: print(f"Skipped {len(skipped)} short/non-secret names: " + ", ".join(sorted(skipped)))
if not hits:
    print("Clean: no secret values found."); sys.exit(0)
print(("REDACTED" if fix else "FOUND") + f" {len(hits)} secret(s) in {len({f for fs in hits.values() for f in fs})} file(s):")
for label, fs in sorted(hits.items()):
    print(f"  {label}: {len(fs)} file(s)")
    for f in fs[:8]: print(f"      {f}")
    if len(fs) > 8: print(f"      ... and {len(fs)-8} more")
if not fix: print("\nRe-run with --fix to replace each value with <REDACTED:NAME> in place.")
sys.exit(2)
PY
    local fix=false ; local paths=() ; local min_len=8 ; local skip_re='(_URL|_DB|_IP|_HOST|_EMAIL|_USER|_REGION|_NAME|_BUCKET)$'
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --fix) fix=true; shift ;;
            --min-length) min_len="$2"; shift 2 ;;
            --skip) skip_re="$2"; shift 2 ;;
            --) shift; break ;;
            *) paths+=("$1"); shift ;;
        esac
    done
    if [[ ${#paths[@]} -eq 0 ]]; then
        paths=("$HOME/.claude" "$HOME/.claude-archive" "$HOME/.zsh_history" "$HOME/.bash_history" "$HOME/.secret-lover")
    fi
    if [[ ! -x "$HELPER" ]]; then
        echo "Error: keychain-helper not found" >&2; exit 1
    fi
    log_access "SCRUB" "-" "$($fix && echo fix || echo scan)"
    # name<TAB>namespace<TAB>value  — piped to python on stdin, never on argv or disk
    "$HELPER" list-all 2>/dev/null | while IFS=$'\t' read -r name ns; do
        local v
        if [[ "$ns" == "global" ]]; then v=$("$HELPER" get "$name" 2>/dev/null) || continue
        else v=$("$HELPER" get "$name" "$ns" 2>/dev/null) || continue; fi
        printf '%s\t%s\t%s\n' "$name" "$ns" "$v"
    done | SL_FIX="$fix" SL_MIN="$min_len" SL_SKIP="$skip_re" python3 -c "$SCRUB_PY" "${paths[@]}"
}

# Main dispatch
case "${1:-help}" in
    add)
        shift
        cmd_add "$@"
        ;;
    get)
        shift
        cmd_get "$@"
        ;;
    list|ls)
        shift
        cmd_list "$@"
        ;;
    delete|remove|rm)
        shift
        cmd_delete "$@"
        ;;
    check|test)
        cmd_check
        ;;
    clear-auth)
        cmd_clear_auth
        ;;
    init)
        shift
        cmd_init "$@"
        ;;
    verify|check-project)
        cmd_verify
        ;;
    migrate)
        cmd_migrate
        ;;
    run|exec)
        shift
        cmd_run "$@"
        ;;
    import)
        shift
        cmd_import "$@"
        ;;
    scrub)
        shift
        cmd_scrub "$@"
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo "Run 'secret-lover help' for usage" >&2
        exit 1
        ;;
esac
